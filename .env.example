# EXPO_PUBLIC values are embedded in the application bundle. Never put a secret here.
# This RevenueCat value is the public Apple SDK key, not a RevenueCat secret API key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_public_sdk_key
EXPO_PUBLIC_PLUS_PURCHASES_ENABLED=false
EXPO_PUBLIC_PLUS_PREVIEW_MODE=store
EXPO_PUBLIC_WEBSITE_URL=
