{
  "expo": {
    "name": "Pilly",
    "slug": "pilly-app",
    "scheme": "pilly-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "dev.sidequests.pilly",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#21191E",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dev.sidequests.pilly.widgets",
          "groupIdentifier": "group.dev.sidequests.pilly",
          "widgets": [
            {
              "name": "NextDoseWidget",
              "displayName": "Pilly · Next dose",
              "description": "See your next medicine time at a glance.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pilly to choose a private photo for your medicine or profile.",
          "cameraPermission": "Allow Pilly to take a private photo for your medicine or profile.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "dev.sidequests.pilly.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.dev.sidequests.pilly"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "2adfb178-e395-4e8b-abf4-8f8d34c9dcfb"
      }
    },
    "owner": "mattenarle10"
  }
}
